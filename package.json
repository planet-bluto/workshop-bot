{
  "name": "typescript-template",
  "version": "0.0.1",
  "description": ">PLANET_BLUTO TypeScript Template",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "alt_start": "ts-node src/main.ts",
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/main.ts --ignore *.json",
    "task": "nodemon --exec ts-node src/admin_task.ts --ignore *.json"
  },
  "author": ">PLANET_BLUTO",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.6",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@twurple/api": "^8.2.0",
    "@twurple/eventsub-http": "^8.2.0",
    "@types/node-schedule": "^2.1.8",
    "colord": "^2.14.0",
    "discord.js": "^14.18.0",
    "discord.js-selfbot-v13": "^3.6.1",
    "dotenv": "^16.4.7",
    "eventemitter3": "^5.0.1",
    "express": "^4.21.2",
    "lowdb": "^7.0.1",
    "luxon": "^3.7.2",
    "node-schedule": "^2.1.2"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
